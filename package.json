{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13 || >=24.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "db:backfill:account-encryption": "tsx src/scripts/backfill-account-encryption.ts",
    "db:backfill:budget-encryption": "tsx src/scripts/backfill-budget-encryption.ts",
    "db:backfill:encrypted-companions": "tsx src/scripts/backfill-encrypted-companions.ts",
    "db:migrate:dev": "npx prisma@7.9.0 migrate dev",
    "db:migrate:prod": "npx prisma@7.9.0 migrate deploy",
    "build": "prisma generate && next build",
    "contracts:typecheck": "pnpm --dir packages/contracts typecheck",
    "mobile:start": "pnpm --dir apps/mobile start",
    "mobile:android": "pnpm --dir apps/mobile android",
    "mobile:ios": "pnpm --dir apps/mobile ios",
    "mobile:lint": "pnpm --dir apps/mobile lint",
    "mobile:typecheck": "pnpm --dir apps/mobile typecheck",
    "test:mobile-server": "node --import tsx --test src/server/auth/mobile-session-auth.test.ts src/server/auth/mobile-session-token.test.ts src/server/auth/verify-credentials.test.ts src/server/mobile-api/bounded-form-data.test.ts src/server/mobile-api/dashboard-dto.test.ts src/server/transactions/transaction-account-policy.test.ts src/server/transactions/transaction-balance-effects.test.ts src/server/transactions/transaction-capability-policy.test.ts src/server/transactions/transaction-location-policy.test.ts src/server/transactions/transaction-ocr-result.test.ts src/server/transactions/transaction-ocr-validation.test.ts packages/contracts/src/transaction.test.ts",
    "start": "next start",
    "start:https": "next start --experimental-https",
    "lint": "eslint",
    "test:interest": "node --import tsx --experimental-test-module-mocks --test src/lib/interest-posting.test.ts"
  },
  "dependencies": {
    "@finhealth/contracts": "workspace:*",
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-mariadb": "7.9.0",
    "@prisma/client": "7.9.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/papaparse": "^5.5.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.0.8",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "otpauth": "^9.5.1",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-joyride": "^3.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "yahoo-finance2": "^3.13.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@openai/codex-security": "^0.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
